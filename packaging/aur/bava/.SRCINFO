pkgbase = bava
	pkgdesc = Music visualizer driven by cavacore, MPRIS, and PipeWire/PulseAudio
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/dekuraan/bava
	arch = x86_64
	license = MIT
	license = Apache-2.0
	makedepends = cargo
	makedepends = clang
	makedepends = pkgconf
	makedepends = pipewire
	depends = gcc-libs
	depends = glibc
	depends = libpulse
	depends = libpipewire
	depends = dbus
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	depends = libxcursor
	depends = libxrandr
	depends = libxi
	depends = vulkan-icd-loader
	depends = systemd-libs
	depends = hicolor-icon-theme
	optdepends = pipewire-pulse: PipeWire as PulseAudio drop-in (replaces libpulse at runtime)
	optdepends = spotifyd: Spotify MPRIS player for album art and now-playing info
	optdepends = ffmpeg: offline music-video rendering (--input song.mp3 --out video.mp4)
	optdepends = vulkan-radeon: Vulkan driver for AMD GPUs
	optdepends = vulkan-intel: Vulkan driver for Intel GPUs
	optdepends = nvidia-utils: Vulkan driver for NVIDIA GPUs
	conflicts = bava-git
	options = !lto
	source = bava-0.3.0.tar.gz::https://github.com/dekuraan/bava/archive/refs/tags/v0.3.0.tar.gz
