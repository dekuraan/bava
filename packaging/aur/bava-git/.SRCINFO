pkgbase = bava-git
	pkgdesc = Music visualizer driven by cavacore, MPRIS, and PipeWire/PulseAudio (git)
	pkgver = r31.g697d611
	pkgrel = 1
	url = https://github.com/dekuraan/bava
	arch = x86_64
	license = MIT
	license = Apache-2.0
	makedepends = cargo
	makedepends = clang
	makedepends = pkgconf
	makedepends = pipewire
	makedepends = git
	depends = gcc-libs
	depends = glibc
	depends = libpulse
	depends = libpipewire
	depends = dbus
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	depends = libxcursor
	depends = libxrandr
	depends = libxi
	depends = vulkan-icd-loader
	depends = systemd-libs
	depends = hicolor-icon-theme
	optdepends = pipewire-pulse: PipeWire as PulseAudio drop-in (replaces libpulse at runtime)
	optdepends = spotifyd: Spotify MPRIS player for album art and now-playing info
	optdepends = ffmpeg: offline music-video rendering (--input song.mp3 --out video.mp4)
	optdepends = vulkan-radeon: Vulkan driver for AMD GPUs
	optdepends = vulkan-intel: Vulkan driver for Intel GPUs
	optdepends = nvidia-utils: Vulkan driver for NVIDIA GPUs
	provides = bava
	conflicts = bava
	options = !lto
	source = bava::git+https://github.com/dekuraan/bava.git
	sha256sums = SKIP

pkgname = bava-git
